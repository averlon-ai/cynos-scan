{
  "name": "@averlon-ai/cynos-scan-engine",
  "version": "0.3.1",
  "license": "Apache-2.0",
  "description": "Upstream @openai/codex-security through cynos with a knowledge base: the scan engine behind the cynos CLI and the cynos-scan action",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "assets"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/averlon-ai/cynos-scan.git",
    "directory": "packages/engine"
  },
  "scripts": {
    "test": "bun test",
    "build": "bun run typecheck",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc --noEmit -p . && node ../../node_modules/@typescript/native/bin/tsc -p assets/scan-prompt/scripts",
    "lint": "eslint src assets/scan-prompt/scripts",
    "format": "prettier --write \"src/**/*.ts\" \"assets/scan-prompt/scripts/*.{js,ts}\""
  },
  "dependencies": {
    "@openai/codex-security": "0.9.1"
  },
  "devDependencies": {
    "@types/bun": "1.2.17",
    "@types/node": "^26.6.6"
  }
}
