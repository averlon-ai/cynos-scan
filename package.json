{
  "name": "cynos-scan",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test packages",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint \"packages/**/*.ts\" \"packages/engine/assets/scan-prompt/scripts/*.js\"",
    "lint:fix": "eslint \"packages/**/*.ts\" --fix",
    "format": "prettier --write \"packages/**/*.ts\" \"packages/engine/assets/scan-prompt/scripts/*.js\"",
    "format:check": "prettier --check \"packages/**/*.ts\" \"packages/engine/assets/scan-prompt/scripts/*.js\""
  },
  "devDependencies": {
    "@types/bun": "^1.2.17",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.0",
    "typescript": "^6.0.3"
  }
}
